library(bio3d)
library(tidyverse)
library(easystats)
library(ggpubr)
pdb_files <- list.files(path = "PDBs/", pattern = "\\.pdb$", full.names = TRUE)
all_sequences <- pdb_files %>%
set_names(str_remove(basename(.), "\\.pdb$")) %>%
map(~ read.pdb(.)$seqres %>%
aa321() %>%
paste(collapse = ""))
print(all_sequences)
